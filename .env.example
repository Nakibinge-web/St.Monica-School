# St. Monica Junior School CMS - Environment Configuration
# Copy this file to ".env" in the project root and fill in real values.
# Never commit the real .env file to version control.

# Application
APP_ENV=production
APP_DEBUG=false

# Database
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_DATABASE=your_db_name
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Outgoing Mail (SMTP) - used by ADMIN/services/EmailService.php
# If MAIL_HOST is left blank, the system logs emails instead of sending them,
# so nothing breaks in development.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@stmonicakasanje.ac.ug
MAIL_FROM_NAME="St. Monica Junior School"

# Backups - directory where database dumps are stored. Defaults to
# ADMIN/storage/backups, which is auto-protected by a generated .htaccess
# (Require all denied) and never listed publicly; downloads are always
# streamed through an authenticated admin script, never linked to directly.
# For extra safety in production, point this at a path outside the web root.
BACKUP_DIR=
# Optional: full path to the mysqldump/mysql client binaries if they are not
# on the system PATH (e.g. on XAMPP: D:\xampp\mysql\bin\mysqldump.exe).
# Leave blank to auto-detect.
MYSQLDUMP_BIN=
MYSQL_BIN=
