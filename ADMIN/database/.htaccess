# Schema, seed, and migration SQL files must never be directly downloadable.
# setup.php itself stays reachable (linked from the admin sidebar).
Options -Indexes

<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
